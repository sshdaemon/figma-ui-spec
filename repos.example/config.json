{
  "root": "/absolute/path/to/your/project",
  "theme": {
    "base": "node_modules/tailwindcss/theme.css",
    "files": ["src/styles/globals.css"],
    "rootPx": 16,
    "fontFamilies": {
      "sans": "Inter"
    }
  },
  "typography": [
    {
      "component": "Heading",
      "file": "src/ui/heading.tsx",
      "cva": "headingVariants"
    }
  ],
  "protectedPaths": ["src/ui/**", "!**/*.test.tsx", "src/styles/globals.css"],
  "specs": ["/absolute/path/to/docs/*/*.ui-spec.json"],
  "design": {
    "skip": [
      {
        "name": "^Annotation",
        "reason": "annotation"
      },
      {
        "type": "SECTION",
        "name": "^Archive",
        "reason": "old versions"
      }
    ]
  },
  "components": {
    "dirs": ["src/ui"],
    "iconDirs": ["src/icons"],
    "lucide": "node_modules/lucide-react/dist/esm/icons"
  }
}
